# Supabase project settings — Project Settings → API in the Supabase dashboard.
# Use the "publishable" key, NOT the "secret" key — the secret key bypasses
# Row Level Security entirely, which would defeat the passcode mechanism below.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Shared household passcode — must exactly match the value inserted into
# app_config in schema.sql. Make up anything memorable; it's not a Supabase
# concept, just a shared secret this app checks.
HOUSEHOLD_PASSCODE=change-me

# Read-only passcode — must exactly match readonly_passcode in app_config
# (schema.sql / readonly-migration.sql) and differ from HOUSEHOLD_PASSCODE.
# Logging in with it allows viewing only; every write is rejected.
READONLY_PASSCODE=change-me-readonly

# Random long string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too
